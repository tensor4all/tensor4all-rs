diff --git a/crates/tensor4all-partitionedtreetn/src/reconstruction/profile_1497.rs b/crates/tensor4all-partitionedtreetn/src/reconstruction/profile_1497.rs
new file mode 100644
index 00000000..0dd73bf2
--- /dev/null
+++ b/crates/tensor4all-partitionedtreetn/src/reconstruction/profile_1497.rs
@@ -0,0 +1,59 @@
+//! Temporary serial-only observation for issue #1497. No numerical policy changes.
+use std::cell::Cell;
+use std::time::Instant;
+
+pub(super) struct Profile {
+    scope: &'static str,
+    origin: Option<Instant>,
+    completed: Cell<bool>,
+}
+
+impl Profile {
+    pub(super) fn new(scope: &'static str) -> Self {
+        Self {
+            scope,
+            origin: (std::env::var_os("T4A_MERGE_REFINE_PROFILE").as_deref()
+                == Some(std::ffi::OsStr::new("1")))
+                .then(Instant::now),
+            completed: Cell::new(false),
+        }
+    }
+
+    pub(super) fn span(&self, phase: &'static str, level: usize, index: usize) -> Span<'_> {
+        Span { profile: self, phase, level, index, started: self.origin.map(|_| Instant::now()) }
+    }
+
+    pub(super) fn complete(&self) {
+        self.completed.set(true);
+    }
+}
+
+pub(super) struct Span<'a> {
+    profile: &'a Profile,
+    phase: &'static str,
+    level: usize,
+    index: usize,
+    started: Option<Instant>,
+}
+
+impl Drop for Span<'_> {
+    fn drop(&mut self) {
+        let (Some(started), Some(origin)) = (self.started, self.profile.origin) else { return };
+        let elapsed_ns = started.elapsed().as_nanos();
+        let start_ns = started.duration_since(origin).as_nanos();
+        let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+        let read = |key: &str| {
+            status.lines().find_map(|line| {
+                line.strip_prefix(key)?.split_whitespace().next()?.parse::<u64>().ok()
+            }).map_or_else(|| "null".to_string(), |value| value.to_string())
+        };
+        let completed = if self.phase == "total" {
+            if self.profile.completed.get() { "true" } else { "false" }
+        } else { "null" };
+        eprintln!(
+            "T4A_PROFILE {{\"scope\":\"{}\",\"phase\":\"{}\",\"level\":{},\"index\":{},\"start_ns\":{},\"elapsed_ns\":{},\"rss_kib\":{},\"hwm_kib\":{},\"threads\":{},\"completed\":{}}}",
+            self.profile.scope, self.phase, self.level, self.index, start_ns, elapsed_ns,
+            read("VmRSS:"), read("VmHWM:"), read("Threads:"), completed
+        );
+    }
+}
