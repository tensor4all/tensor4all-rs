    "gate": "ai-run build --mem 6G",
    "actual_output": [
      "baseline ordinary rejected: IdxTensor IdxTensor failed: Internal label shape mismatch: label 0 has dimensions 2 and 3; prepared constructor accepted: true",
      "test prepared_contraction::review_probe_retained_dimension_validation_timing ... ok",
      "test result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 525 filtered out; finished in 0.02s"
    ],
    "test_source": "#[test]\nfn review_probe_retained_dimension_validation_timing() {\n    let small = tensor4all_core::Index::new(tensor4all_core::DynId(701), 2);\n    let large = tensor4all_core::Index::new(tensor4all_core::DynId(701), 3);\n    let a = tensor4all_core::IdxTensor::from_dense(vec![small.clone()], vec![1.0_f64, 2.0]).unwrap();\n    let b = tensor4all_core::IdxTensor::from_dense(vec![large], vec![3.0_f64, 4.0, 5.0]).unwrap();\n    let retained = [small];\n    let options = tensor4all_core::ContractionOptions::new().with_retain_indices(&retained);\n    let ordinary = tensor4all_core::contract_with_options(&[&a, &b], options).unwrap_err();\n    let prepared = tensor4all_core::PreparedContraction::new(&[&a, &b], options);\n    println!(\"baseline ordinary rejected: {ordinary}; prepared constructor accepted: {}\", prepared.is_ok());\n    assert!(ordinary.to_string().contains(\"Internal label shape mismatch\"));\n    assert!(prepared.is_ok());\n}\n",
    "result": "The old ordinary dense call rejects the mismatch; the old prepared constructor accepts the invalid metadata. The PR rejects both at planning."
  }
